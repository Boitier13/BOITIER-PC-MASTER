{
  "name": "boitier-pc-master",
  "version": "0.1.0",
  "private": true,
  "description": "BOITIER PC MASTER — exploration et inventaire de fichiers, désinstallation avancée. Application Windows hors ligne (Tauri 2).",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
